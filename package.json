{
  "name": "brilla",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "build:app": "vite build --mode app --outDir dist-app",
    "voice:script": "esbuild scripts/voice-script.mjs --bundle --platform=node --format=esm --log-level=error --outfile=node_modules/.cache/voice-script.mjs && node node_modules/.cache/voice-script.mjs",
    "voice:sync": "esbuild scripts/voice-sync.mjs --bundle --platform=node --format=esm --log-level=error --outfile=node_modules/.cache/voice-sync.mjs && node node_modules/.cache/voice-sync.mjs",
    "voice:pdf": "node scripts/voice-pdf.mjs",
    "build:admin": "vite build --mode admin --outDir dist-admin"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@fontsource/dancing-script": "^5.1.0",
    "@fontsource/fredoka": "^5.1.0",
    "@supabase/supabase-js": "^2.119.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^6.28.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@eslint/js": "^9.25.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^7.0.2",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^0.21.1"
  }
}
